# Supabase Configuration
# Obtain these from your Supabase Dashboard -> Project Settings -> Database / API

# 1. Supabase REST API & Client Credentials
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_KEY=your-anon-or-service-role-key

# 2. Supabase PostgreSQL Direct / Connection Pooler URL (SQLAlchemy compatible)
# Session / Transaction pooler mode (port 6543 or 5432)
SUPABASE_DB_URL=postgresql+psycopg://postgres.your-project-id:your-db-password@aws-0-us-east-1.pooler.supabase.com:6543/postgres
DATABASE_URL=postgresql+psycopg://postgres.your-project-id:your-db-password@aws-0-us-east-1.pooler.supabase.com:6543/postgres

# Application Settings
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
ENVIRONMENT=development
